{
    "name": "@webspejd",
    "version": "2026-05-08",
    "license": "MIT",
    "private": true,
    "workspaces": [
        "core",
        "server",
        "client"
    ],
    "devDependencies": {
        "typescript": "^5.0.0"
    },
    "scripts": {
        "start": "node server/target/server.js",
        "build": "npm run build -w core -w server -w client",
        "clean": "rm -rf */tsconfig.tsbuildinfo core/target client/target server/target",
        "build:watch": "npx tsc --build --watch -w core -w server -w client",
        "generateDatabase": "node server/target/database/generateDatabase.js"
    }
}
